@* MudBlazor-providere. Legges øverst i hver interaktive side som bruker MudBlazor,
   siden appen bruker interaktivitet per side og layouten er statisk. *@
<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    private static readonly MudTheme Theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#194d36",
            Secondary = "#2f7d57",
            Success = "#2f7d57",
            AppbarBackground = "#194d36",
            Background = "#f5f7f5",
            TextPrimary = "#1c2420",
            TextSecondary = "#4b5a52"
        },
        // Samme avrunding som .btn og .fh-card i app.css. Kort (MudPaper) får større radius via CSS.
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "6px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"]
            },
            // Vanlig skrift på knapper (ikke VERSALER), i samme størrelse som Bootstrap-knappene.
            Button = new ButtonTypography
            {
                TextTransform = "none",
                FontSize = "1rem",
                FontWeight = "500",
                LetterSpacing = "normal"
            },
            // Overskriftene følger de samme størrelsene som h1/h2 i app.css.
            H5 = new H5Typography { FontSize = "1.5rem", FontWeight = "650", LineHeight = "1.3" },
            H6 = new H6Typography { FontSize = "1.15rem", FontWeight = "650", LineHeight = "1.35" }
        }
    };
}
