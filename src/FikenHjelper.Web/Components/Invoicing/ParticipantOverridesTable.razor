@using System.Globalization

<div class="fh-stack">
    <search>
        <div class="fh-field mb-0">
            <label for="participant-search">Filtrer deltakere på navn eller speidergruppe</label>
            <input id="participant-search"
                   type="search"
                   value="@searchQuery"
                   @oninput="HandleSearchInput"
                   placeholder="Søk etter navn, gruppe eller kategori…" />
        </div>
    </search>

    @if (MultiGroupParticipantCount > 0)
    {
        <div class="fh-actions">
            <label class="fh-checkbox-option">
                <input id="filter-multigroup" type="checkbox" @bind="onlyMultipleGroups" />
                <span>Vis kun deltakere med flere grupper (@MultiGroupParticipantCount)</span>
            </label>
        </div>
    }

    <div tabindex="0" role="region" aria-labelledby="participants-table-caption" class="table-wrapper">
        <table class="participants-table">
            <caption id="participants-table-caption">
                Deltakere (@FilteredParticipants.Count av @EventData.Participants.Count)
            </caption>
            <thead>
                <tr>
                    <th>Deltaker</th>
                    <th>Inkluder</th>
                    <th>Dekkes av kretsen</th>
                    <th>Speidergruppe</th>
                    <th>Kategori</th>
                    <th>Status</th>
                    <th class="fh-num-col">Pris (kr)</th>
                    <th>Svar / detaljer</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var participant in FilteredParticipants)
                {
                    var included = InvoicePlanBuilder.IsParticipantIncluded(
                        participant,
                        Filters,
                        CategoryPrices,
                        Overrides,
                        ExcludedCategoryKeys);
                    var coveredByDistrict = InvoicePlanBuilder.IsCoveredByDistrict(participant, Overrides);
                    var effectiveGroup = InvoicePlanBuilder.ResolveEffectiveGroupName(participant, Overrides);
                    var hasCustomGroup = !string.Equals(effectiveGroup, participant.GroupName, StringComparison.OrdinalIgnoreCase);
                    var hasCustomPrice = Overrides.TryGetValue(participant.ParticipantKey, out var ov) && ov.CustomPriceNok.HasValue;
                    var effectivePrice = InvoicePlanBuilder.ResolveEffectivePriceNok(participant, CategoryPrices, Overrides);
                    var priceInputId = $"part-price-{participant.ParticipantKey}";
                    var includeInputId = $"part-inc-{participant.ParticipantKey}";
                    var districtInputId = $"part-dist-{participant.ParticipantKey}";
                    var groupSelectId = $"part-grp-{participant.ParticipantKey}";
                    var availableNames = participant.AvailableGroups
                        .Select(g => g.GroupName)
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);
                    var otherGroups = AllKnownGroups
                        .Where(g => !availableNames.Contains(g))
                        .ToList();
                    var hasEffectiveInOptions = availableNames.Contains(effectiveGroup)
                        || otherGroups.Contains(effectiveGroup, StringComparer.OrdinalIgnoreCase)
                        || string.Equals(effectiveGroup, "Uten gruppe", StringComparison.OrdinalIgnoreCase);

                    <tr @key="participant.ParticipantKey">
                        <th scope="row">
                            @participant.FullName
                            @if (participant.MemberNo.HasValue)
                            {
                                <div class="fh-hint">Medl.nr @participant.MemberNo.Value</div>
                            }
                        </th>
                        <td>
                            <input id="@includeInputId"
                                   type="checkbox"
                                   aria-label="Inkluder @participant.FullName"
                                   checked="@included"
                                   @onchange="(e) => HandleIncludeChanged(participant.ParticipantKey, e)" />
                        </td>
                        <td>
                            <input id="@districtInputId"
                                   type="checkbox"
                                   aria-label="Dekkes av kretsen for @participant.FullName"
                                   checked="@coveredByDistrict"
                                   @onchange="(e) => HandleCoveredByDistrictChanged(participant.ParticipantKey, e)" />
                        </td>
                        <td>
                            <div class="fh-group-cell">
                                <label for="@groupSelectId" class="visually-hidden">Speidergruppe for @participant.FullName</label>
                                <select id="@groupSelectId"
                                        class="fh-group-select"
                                        value="@effectiveGroup"
                                        @onchange="(e) => HandleGroupChanged(participant.ParticipantKey, e)">
                                    @if (participant.AvailableGroups.Count > 0)
                                    {
                                        <optgroup label="Deltakerens grupper (Min speiding)">
                                            @foreach (var opt in participant.AvailableGroups)
                                            {
                                                var label = string.IsNullOrWhiteSpace(opt.SourceLabel)
                                                    ? opt.GroupName
                                                    : $"{opt.GroupName} ({opt.SourceLabel})";
                                                <option @key="opt.GroupName" value="@opt.GroupName">@label</option>
                                            }
                                        </optgroup>
                                    }
                                    @if (otherGroups.Count > 0)
                                    {
                                        <optgroup label="Andre speidergrupper">
                                            @foreach (var g in otherGroups)
                                            {
                                                <option @key="g" value="@g">@g</option>
                                            }
                                        </optgroup>
                                    }
                                    @if (!hasEffectiveInOptions)
                                    {
                                        <option value="@effectiveGroup">@effectiveGroup</option>
                                    }
                                    <option value="Uten gruppe">Uten gruppe</option>
                                </select>
                                @if (participant.HasMultipleGroups || hasCustomGroup)
                                {
                                    <div class="fh-group-badges">
                                        @if (participant.HasMultipleGroups)
                                        {
                                            <span class="fh-badge fh-badge-warn">Flere grupper (@participant.AvailableGroups.Count)</span>
                                        }
                                        @if (hasCustomGroup)
                                        {
                                            <span class="fh-badge fh-badge-neutral">Endret fra @participant.GroupName</span>
                                        }
                                    </div>
                                }
                            </div>
                        </td>
                        <td>@InvoicePlanBuilder.ResolveEffectiveFeeLabel(participant, CategoryLabels)</td>
                        <td>
                            @if (participant.Cancelled)
                            {
                                <span class="fh-badge fh-badge-danger">Avmeldt</span>
                            }
                            else if (participant.Confirmed)
                            {
                                <span class="fh-badge fh-badge-ok">Bekreftet</span>
                            }
                            else
                            {
                                <span class="fh-badge fh-badge-warn">Ubekreftet</span>
                            }
                            @if (participant.Attended || participant.CheckedIn)
                            {
                                <span class="fh-badge fh-badge-neutral">Deltok</span>
                            }
                            @if (included && coveredByDistrict)
                            {
                                <span class="fh-badge fh-badge-warn">Dekkes av kretsen</span>
                            }
                        </td>
                        <td class="fh-num-col">
                            <label for="@priceInputId" class="visually-hidden">Overstyrt pris for @participant.FullName</label>
                            <input id="@priceInputId"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   value="@(hasCustomPrice ? ov!.CustomPriceNok!.Value.ToString(CultureInfo.InvariantCulture) : string.Empty)"
                                   placeholder="@effectivePrice.ToString("0.##", CultureInfo.InvariantCulture)"
                                   @onchange="(e) => HandleCustomPriceChanged(participant.ParticipantKey, e)" />
                        </td>
                        <td>
                            @if (participant.Answers.Count == 0)
                            {
                                <span class="fh-hint">–</span>
                            }
                            else
                            {
                                @string.Join(" | ", participant.Answers.Select(kv => $"{kv.Key}: {kv.Value}"))
                            }
                        </td>
                    </tr>
                }
                @if (FilteredParticipants.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="fh-hint">
                            @(EventData.Participants.Count == 0
                                ? "Arrangementet har ingen deltakere."
                                : "Ingen treff. Prøv et annet søk eller fjern filteret.")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <details class="fh-diagnostics">
        <summary>API-diagnostikk fra Min speiding (rådata og ekstra felter)</summary>
        <div class="mt-2">
            <p class="fh-hint mb-1">
                <strong>Prosjekt-ID:</strong> @EventData.ProjectId
                · <strong>Spørsmål-endepunkt:</strong> @(EventData.QuestionsEndpointAvailable ? "Tilgjengelig" : "Ikke brukt / ikke tilgjengelig")
                · <strong>Deltakere med flere grupper i API:</strong> @MultiGroupParticipantCount
                · <strong>Demodata:</strong> @(EventData.IsDemoData ? "Ja" : "Nei")
            </p>
            <p class="fh-hint mb-1">
                <strong>Prislabels (<code>labels.project_fee</code>):</strong>
                @(EventData.FeeLabels.Count == 0
                    ? "Ingen returnert"
                    : string.Join(", ", EventData.FeeLabels.Select(kv => $"{kv.Key}={kv.Value}")))
            </p>
            <p class="fh-hint mb-0">
                <strong>Ekstra felter funnet på deltakere:</strong>
                @(EventData.ExtraParticipantPropertyNames.Count == 0
                    ? "Ingen"
                    : BuildSafeExtraFieldSummary())
            </p>
        </div>
    </details>
</div>

@code {
    private static readonly CultureInfo NorwegianCulture = CultureInfo.GetCultureInfo("nb-NO");
    private static readonly string[] SensitiveDiagnosticFragments =
    [
        "ssno",
        "fnr",
        "personnr",
        "phone",
        "telefon",
        "email",
        "epost",
        "address",
        "adresse",
        "birth",
        "dob"
    ];

    private string searchQuery = string.Empty;
    private bool onlyMultipleGroups;

    [Parameter, EditorRequired] public MinSpeidingEventLoadResult EventData { get; set; } = default!;
    [Parameter, EditorRequired] public ParticipantFilterOptions Filters { get; set; } = new();
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, decimal> CategoryPrices { get; set; } = new Dictionary<string, decimal>();
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, ParticipantOverride> Overrides { get; set; } = new Dictionary<string, ParticipantOverride>();
    [Parameter, EditorRequired] public IReadOnlySet<string> ExcludedCategoryKeys { get; set; } = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public IReadOnlyDictionary<string, string>? CategoryLabels { get; set; }
    [Parameter] public IReadOnlyList<string> KnownGroupNames { get; set; } = [];

    [Parameter] public EventCallback<(string ParticipantKey, bool? Included)> OnIncludeChanged { get; set; }
    [Parameter] public EventCallback<(string ParticipantKey, decimal? CustomPriceNok)> OnCustomPriceChanged { get; set; }
    [Parameter] public EventCallback<(string ParticipantKey, bool CoveredByDistrict)> OnCoveredByDistrictChanged { get; set; }
    [Parameter] public EventCallback<(string ParticipantKey, string? CustomGroupName)> OnGroupChanged { get; set; }

    private int MultiGroupParticipantCount => EventData.Participants.Count(p => p.HasMultipleGroups);

    private IReadOnlyList<string> AllKnownGroups =>
        EventData.Participants
            .SelectMany(p => p.AvailableGroups.Select(g => g.GroupName).Prepend(p.GroupName))
            .Concat(KnownGroupNames)
            .Where(g => !string.IsNullOrWhiteSpace(g) && !string.Equals(g, "Uten gruppe", StringComparison.OrdinalIgnoreCase))
            .Select(g => g.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => g, StringComparer.Create(NorwegianCulture, ignoreCase: true))
            .ToList();

    private IReadOnlyList<EventParticipant> FilteredParticipants =>
        EventData.Participants
            .Where(p => !onlyMultipleGroups || p.HasMultipleGroups)
            .Where(p => string.IsNullOrWhiteSpace(searchQuery)
                || p.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || InvoicePlanBuilder.ResolveEffectiveGroupName(p, Overrides).Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || p.GroupName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || p.AvailableGroups.Any(g => g.GroupName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                || InvoicePlanBuilder.ResolveEffectiveFeeLabel(p, CategoryLabels).Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || p.FeeLabel.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private void HandleSearchInput(ChangeEventArgs e)
        => searchQuery = e.Value?.ToString() ?? string.Empty;

    private Task HandleIncludeChanged(string key, ChangeEventArgs e)
        => OnIncludeChanged.InvokeAsync((key, e.Value is bool b ? b : null));

    private Task HandleCoveredByDistrictChanged(string key, ChangeEventArgs e)
        => OnCoveredByDistrictChanged.InvokeAsync((key, e.Value is bool b && b));

    private Task HandleGroupChanged(string key, ChangeEventArgs e)
    {
        var selected = e.Value?.ToString()?.Trim();
        return OnGroupChanged.InvokeAsync((key, string.IsNullOrWhiteSpace(selected) ? null : selected));
    }

    private Task HandleCustomPriceChanged(string key, ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? string.Empty).Trim().Replace(',', '.');
        if (string.IsNullOrEmpty(raw))
        {
            return OnCustomPriceChanged.InvokeAsync((key, null));
        }

        if (decimal.TryParse(raw, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed) && parsed >= 0)
        {
            return OnCustomPriceChanged.InvokeAsync((key, parsed));
        }

        return Task.CompletedTask;
    }

    private string BuildSafeExtraFieldSummary()
    {
        var parts = new List<string>(EventData.ExtraParticipantPropertyNames.Count);
        foreach (var fieldName in EventData.ExtraParticipantPropertyNames)
        {
            if (IsSensitiveDiagnosticKey(fieldName))
            {
                parts.Add($"{fieldName} (skjult)");
                continue;
            }

            var nonEmptyValues = EventData.Participants
                .Select(p => p.ExtraFields.TryGetValue(fieldName, out var val) ? val?.Trim() : null)
                .Where(val => !string.IsNullOrWhiteSpace(val))
                .Cast<string>()
                .ToList();

            var sample = nonEmptyValues.FirstOrDefault(v => !TrivialDiagnosticValues.Contains(v))
                ?? nonEmptyValues.FirstOrDefault();

            if (string.IsNullOrWhiteSpace(sample))
            {
                parts.Add(fieldName);
            }
            else
            {
                var compact = sample;
                if (compact.Length > 120)
                {
                    compact = compact[..119] + "…";
                }

                parts.Add($"{fieldName} (eks: {compact})");
            }
        }

        return string.Join(", ", parts);
    }

    private static readonly HashSet<string> TrivialDiagnosticValues = new(StringComparer.OrdinalIgnoreCase)
    {
        "0",
        "0.0",
        "0.00",
        "[]",
        "{}",
        "false",
        "null"
    };

    private static bool IsSensitiveDiagnosticKey(string key)
        => SensitiveDiagnosticFragments.Any(f => key.Contains(f, StringComparison.OrdinalIgnoreCase));
}
