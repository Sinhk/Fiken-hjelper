@using System.Globalization

@* Forslag til utbetalinger fra Fiken. Brukeren huker av, og først når tilskuddet lagres blir koblingen varig. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            @if (Suggestions.Count == 0)
            {
                <MudText Typo="Typo.body2">
                    Fant ingen inntektsposteringer som kan være utbetaling. Det letes på de koblede prosjektene og (uten prosjekt) på konto 34xx og 39xx,
                    fra vedtaksdato eller søknadsdato og utover.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Rangert etter beløp som passer, tilskuddsgiverens navn i teksten og dato. Bare det du huker av, kobles til tilskuddet.
                </MudText>
                <div style="max-height: 55vh; overflow: auto">
                    <MudSimpleTable Dense Hover>
                        <thead>
                            <tr>
                                <th></th>
                                <th>Dato</th>
                                <th>Bilag</th>
                                <th>Tekst</th>
                                <th>Kontoer</th>
                                <th class="fh-num-col">Beløp (kr)</th>
                                <th>Hvorfor foreslått</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Shown)
                            {
                                <tr @key="s.JournalEntryId">
                                    <td>
                                        <MudCheckBox T="bool" Value="selected.Contains(s.JournalEntryId)" ValueChanged="v => Toggle(s.JournalEntryId, v)"
                                                     Dense Size="Size.Small" aria-label="@($"Koble bilag {s.JournalEntryNumber}")" />
                                    </td>
                                    <td>@FormatDate(s.Date)</td>
                                    <td>@s.JournalEntryNumber</td>
                                    <td>@s.Description</td>
                                    <td>@string.Join(", ", s.Accounts)</td>
                                    <td class="fh-num-col tabular-nums">@s.Amount.ToString("N2", Nb)</td>
                                    <td>
                                        @foreach (var reason in Reasons(s))
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@reason</MudChip>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
                @if (Suggestions.Count > MaxShown)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Viser de @MaxShown beste av @Suggestions.Count forslag.</MudText>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudText Typo="Typo.caption" Class="mr-auto ml-4">@selected.Count valgt</MudText>
        <MudButton OnClick="Cancel">Avbryt</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(selected.Count == 0)">Koble valgte</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int MaxShown = 200;
    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyList<GrantPaymentSuggestion> Suggestions { get; set; } = [];

    private readonly HashSet<long> selected = [];

    private IEnumerable<GrantPaymentSuggestion> Shown => Suggestions.Take(MaxShown);

    private void Toggle(long id, bool on)
    {
        if (on)
        {
            selected.Add(id);
        }
        else
        {
            selected.Remove(id);
        }
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(Suggestions.Where(s => selected.Contains(s.JournalEntryId)).ToList()));

    private void Cancel() => MudDialog.Cancel();

    private static string FormatDate(string? date) =>
        DateOnly.TryParseExact(date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) ? d.ToString("dd.MM.yyyy", Nb) : date ?? "";

    private static IEnumerable<string> Reasons(GrantPaymentSuggestion s)
    {
        if (s.MatchesAmount)
        {
            yield return "beløpet passer";
        }

        if (s.NameScore > 0)
        {
            yield return $"navnet ligner ({s.NameScore} %)";
        }

        yield return s.OnLinkedProject ? "på koblet prosjekt" : "uten prosjekt, på tilskudds-/inntektskonto";
    }
}
