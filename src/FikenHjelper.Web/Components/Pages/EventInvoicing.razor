@page "/arrangement-fakturering"
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Arrangementsfakturering – Fiken-hjelper</PageTitle>

<PageErrorBoundary>
<div class="fh-stack">
    <section class="fh-card">
        <div class="fh-card-header">
            <h1>Arrangementsfakturering (Min speiding → Fiken-utkast)</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(bannerMessage))
        {
            <div class="fh-alert @(bannerIsError ? "fh-alert-danger" : "fh-alert-info") mb-3" role="status" aria-live="polite">
                @bannerMessage
            </div>
        }

        @if (!fikenTokenConfigured)
        {
            <div class="fh-alert fh-alert-warn mb-3" role="alert">
                <strong>Fiken er ikke tilkoblet ennå.</strong>
                Du kan teste oppsett og forhåndsvisning med demodata nå, og logge inn med Fiken OAuth2 (eller legge inn API-nøkkel) under
                <a href="innstillinger">Innstillinger</a> når du er klar til å opprette utkast.
            </div>
        }

        <FikenContextBar Companies="companies"
                         Projects="projects"
                         IncomeAccounts="incomeAccounts"
                         BankAccounts="bankAccounts"
                         SelectedCompanySlug="@selectedCompanySlug"
                         OnCompanyChanged="HandleCompanyChangedAsync"
                         IsCompanyLocked="isSubmittingDrafts"
                         SelectedProjectId="selectedProjectId"
                         OnProjectChanged="HandleProjectChanged"
                         IncomeAccount="@incomeAccount"
                         OnIncomeAccountChanged="HandleIncomeAccountChanged"
                         BankAccountNumber="@bankAccountNumber"
                         OnBankAccountNumberChanged="HandleBankAccountChanged"
                         IssueDate="issueDate"
                         OnIssueDateChanged="HandleIssueDateChanged"
                         DaysUntilDueDate="daysUntilDueDate"
                         OnDaysUntilDueDateChanged="HandleDueDaysChanged"
                         InvoiceText="@invoiceText"
                         OnInvoiceTextChanged="HandleInvoiceTextChanged"
                         OurReference="@ourReference"
                         OnOurReferenceChanged="HandleOurReferenceChanged"
                         OrderReferencePrefix="@orderReferencePrefix"
                         OnOrderReferencePrefixChanged="HandleOrderPrefixChanged"
                         IsLoadingFiken="isLoadingFiken"
                         OnReloadFiken="ReloadFikenContextAsync" />

        <MinSpeidingSourcePanel ProjectId="@minSpeidingProjectId"
                                OnProjectIdChanged="(v) => minSpeidingProjectId = v"
                                ApiKey="@minSpeidingApiKey"
                                OnApiKeyChanged="(v) => minSpeidingApiKey = v"
                                QuestionsApiKey="@minSpeidingQuestionsApiKey"
                                OnQuestionsApiKeyChanged="(v) => minSpeidingQuestionsApiKey = v"
                                EventNameToSave="@eventNameToSave"
                                OnEventNameToSaveChanged="(v) => eventNameToSave = v"
                                RememberEvent="rememberEvent"
                                OnRememberEventChanged="(v) => rememberEvent = v"
                                SaveApiKeyLocally="saveApiKeyLocally"
                                OnSaveApiKeyLocallyChanged="(v) => saveApiKeyLocally = v"
                                SavedEvents="mappings.SavedEvents"
                                OnSelectSavedEvent="HandleSavedEventSelectedAsync"
                                BillingMode="billingMode"
                                OnBillingModeChanged="HandleBillingModeChanged"
                                GroupLineMode="groupLineMode"
                                OnGroupLineModeChanged="HandleGroupLineModeChanged"
                                Filters="filters"
                                OnFiltersChanged="HandleFiltersChanged"
                                IsLoadingEvent="isLoadingEvent"
                                OnFetchFromMinSpeiding="FetchFromMinSpeidingAsync"
                                OnLoadDemo="LoadDemoEventAsync" />
    </section>

    @if (eventData is not null)
    {
        <section class="fh-card">
            <div class="fh-card-header">
                <h2>@eventData.EventTitle</h2>
                <div class="fh-actions">
                    <span class="fh-badge @(eventData.IsDemoData ? "fh-badge-warn" : "fh-badge-ok")">
                        @(eventData.IsDemoData ? "Demodata" : "Hentet fra Min speiding")
                    </span>
                    @if (draftSaveFailed)
                    {
                        <span class="fh-badge fh-badge-danger" role="alert">
                            Kunne ikke lagre valgene lokalt
                        </span>
                    }
                    else if (lastDraftSavedAtLocal.HasValue)
                    {
                        <span class="fh-badge fh-badge-neutral">
                            Lagret lokalt @lastDraftSavedAtLocal.Value.ToString("HH:mm")
                        </span>
                    }
                    @if (!confirmingReset)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                @onclick="RequestResetSavedEventChoices">
                            Nullstill lagrede valg
                        </button>
                    }
                </div>
            </div>

            @if (draftSaveFailed)
            {
                <div class="fh-alert fh-alert-warn mb-3" role="alert">
                    Valgene for dette arrangementet ble ikke lagret lokalt. Endringene gjelder nå, men kan bli borte hvis du laster siden på nytt.
                </div>
            }

            @if (confirmingReset)
            {
                <div class="fh-alert fh-alert-warn mb-3" role="alert">
                    <p class="mb-2">
                        Vil du nullstille lagrede valg for dette arrangementet? Priser, navn på kategorier, valg per deltaker,
                        kundekoblinger og fakturafelt går tilbake til standard. Dette kan ikke angres.
                    </p>
                    <div class="fh-actions">
                        <button type="button"
                                class="btn btn-danger btn-sm"
                                @onclick="ResetSavedEventChoicesAsync">
                            Ja, nullstill
                        </button>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                @onclick="CancelResetSavedEventChoices">
                            Avbryt
                        </button>
                    </div>
                </div>
            }

            <div class="fh-stack">
                <FeePricingTable Categories="eventData.FeeCategories"
                                 CategoryPrices="categoryPrices"
                                 CategoryLabels="categoryLabels"
                                 ExcludedCategoryKeys="excludedCategoryKeys"
                                 OnCategoryPriceChanged="HandleCategoryPriceChanged"
                                 OnCategoryLabelChanged="HandleCategoryLabelChanged"
                                 OnCategoryIncludeChanged="HandleCategoryIncludeChanged" />

                <ParticipantOverridesTable EventData="eventData"
                                           Filters="filters"
                                           CategoryPrices="categoryPrices"
                                           CategoryLabels="categoryLabels"
                                           Overrides="participantOverrides"
                                           ExcludedCategoryKeys="excludedCategoryKeys"
                                           KnownGroupNames="KnownGroupNames"
                                           OnIncludeChanged="HandleParticipantIncludeChanged"
                                           OnCustomPriceChanged="HandleParticipantPriceChanged"
                                           OnCoveredByDistrictChanged="HandleParticipantCoveredByDistrictChanged"
                                           OnGroupChanged="HandleParticipantGroupChanged" />
            </div>
        </section>

        @if (invoicePlan is not null)
        {
            <section class="fh-card">
                <div class="fh-card-header">
                    <h2>Forhåndsvisning av fakturautkast</h2>
                </div>

                <InvoicePreviewList EventTitle="@eventData.EventTitle"
                                    SelectedProjectLabel="@SelectedProjectLabel"
                                    Plan="invoicePlan"
                                    FikenCustomers="PlanCustomers"
                                    IsDemoData="eventData.IsDemoData"
                                    IsSubmitting="isSubmittingDrafts"
                                    CreationResults="creationResults"
                                    CreationBlockedReason="@CreationBlockedReason"
                                    CreationMessage="@creationMessage"
                                    CreationMessageIsError="creationMessageIsError"
                                    CustomerMessage="customerMessage"
                                    OnManualCustomerSelected="HandleManualCustomerSelected"
                                    OnRememberGroupMapping="HandleRememberGroupMappingAsync"
                                    OnCreateFikenCustomer="HandleCreateFikenCustomerAsync"
                                    OnCreateDraftsRequested="CreateFikenDraftsAsync" />
            </section>
        }
    }
</div>
</PageErrorBoundary>
