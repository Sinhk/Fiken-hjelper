@page "/kvalitetssjekk"
@rendermode InteractiveServer
@using System.Globalization
@using FikenHjelper.Core.Grants
@using FikenHjelper.Core.QualityCheck
@implements IAsyncDisposable
@inject QualityCheckService QualityChecks
@inject GrantService Grants
@inject ILocalConfigStore ConfigStore
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<QualityCheck> Logger

<PageTitle>Kvalitetssjekk – Fiken-hjelper</PageTitle>
<PageErrorBoundary>
<MudProviders />

<MudStack Spacing="4">
    <MudPaper Class="pa-4" Outlined>
        <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" HtmlTag="h1">Kvalitetssjekk</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Ubetalte kundefakturaer, åpne salg, ubetalte kjøp og tilskudd – før styremøte og årsoppgjør.
                </MudText>
            </MudStack>
            <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">
                <MudDatePicker @key="datePickerKey" Label="Forfalt per" Date="ReferenceDateTime" DateChanged="HandleDateChanged"
                               Culture="Nb" DateFormat="dd.MM.yyyy" Editable
                               Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 11rem" />
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" OverrideStyles="false" role="group" aria-label="Hurtigvalg for dato">
                    <MudButton Variant="@(IsToday ? Variant.Filled : Variant.Outlined)" Color="@(IsToday ? Color.Primary : Color.Default)"
                               OnClick="SetToday" UserAttributes="@PressedAttributes(IsToday)">I dag</MudButton>
                    <MudButton Variant="@(IsLastYearEnd ? Variant.Filled : Variant.Outlined)" Color="@(IsLastYearEnd ? Color.Primary : Color.Default)"
                               OnClick="SetLastYearEnd" UserAttributes="@PressedAttributes(IsLastYearEnd)">31.12.@(today.Year - 1)</MudButton>
                </MudButtonGroup>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="@(() => LoadAsync(true))" Disabled="@(isLoading)">
                    Hent på nytt
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopyTableAsync" Disabled="@(report is null || isCopying)">
                    Kopier tabell
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Notes"
                           OnClick="CopyMarkdownAsync" Disabled="@(report is null || isCopying)">
                    Kopier som Markdown
                </MudButton>
            </MudStack>
        </MudStack>

        <div role="status" aria-live="polite">
            @if (isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate Class="mb-1" aria-label="Henter åpne poster fra Fiken" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Henter åpne poster fra Fiken …</MudText>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
        }

        @if (!hasCompany)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Ingen Fiken-foretak er valgt. Koble til Fiken under <MudLink Href="innstillinger">Innstillinger</MudLink>.
            </MudAlert>
        }

        <MudAlert Severity="Severity.Info" Dense Variant="Variant.Text" Class="mb-3">
            Listen viser åpne poster slik de står i Fiken nå@(data is null ? "" : $" (hentet {data.FetchedAt.ToString("dd.MM.yyyy 'kl.' HH:mm", Nb)})").
            Velger du en dato bakover i tid, kommer ikke poster som er betalt etter datoen med, og delbetalinger etter datoen er trukket fra.
            «Kopier tabell» gir en ferdig tabell når du limer inn i Word, Google Docs eller et regneark.
        </MudAlert>

        @if (report is not null)
        {
            <MudGrid Spacing="2">
                @foreach (var section in report.Sections)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined Class="pa-3">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption">@section.Title</MudText>
                                <MudChip T="string" Size="Size.Small" Color="StatusColor(section.Status)" Variant="Variant.Text">
                                    @SectionStatusText(section)
                                </MudChip>
                            </MudStack>
                            <MudText Typo="Typo.h6" Class="tabular-nums">@Kr(section.TotalOre) kr</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @section.Findings.Count stk
                                @if (section.OverdueCount > 0)
                                {
                                    <span> · forfalt @section.OverdueCount stk, @Kr(section.OverdueOre) kr</span>
                                }
                                @if (section.UnknownAmountCount > 0)
                                {
                                    <span> · @section.UnknownAmountCount med ukjent beløp</span>
                                }
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
                @if (report.Grants is { } grantSummary)
                {
                    <MudItem xs="12" md="4">
                        <MudPaper Outlined Class="pa-3">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.caption">@GrantCheckSection.Title</MudText>
                                <MudChip T="string" Size="Size.Small" Color="StatusColor(grantSummary.Status)" Variant="Variant.Text">
                                    @GrantSummaryStatusText(grantSummary)
                                </MudChip>
                            </MudStack>
                            <MudText Typo="Typo.h6" Class="tabular-nums">@grantSummary.Findings.Count funn</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @grantSummary.GrantCount tilskudd kontrollert
                                @if (grantSummary.OverdueCount > 0)
                                {
                                    <span> · frist passert eller forfalt: @grantSummary.OverdueCount stk</span>
                                }
                                @if (grantSummary.MissingDataNote is not null)
                                {
                                    <span> · mangler Fiken-data</span>
                                }
                            </MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
        else if (!RendererInfo.IsInteractive)
        {
            <MudText Color="Color.Secondary">Laster …</MudText>
        }
    </MudPaper>

    @if (report is not null)
    {
        @foreach (var section in report.Sections)
        {
            <MudPaper Class="pa-4" Outlined @key="section.Key">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@section.Title</MudText>
                @if (section.Findings.Count == 0)
                {
                    <MudText Color="Color.Success">Ingen åpne poster.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense Hover Bordered Style="overflow-x: auto">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Referanse</th>
                                <th>Motpart</th>
                                <th>Dato</th>
                                <th>Forfall</th>
                                <th class="fh-num-col">Dager forfalt</th>
                                <th class="fh-num-col">Utestående (kr)</th>
                                <th>Prosjekt</th>
                                <th>Merknad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var finding in section.Findings)
                            {
                                <tr>
                                    <td>
                                        <MudChip T="string" Size="Size.Small" Color="StatusColor(finding.Status)">
                                            @QualityCheckTextFormatter.StatusText(finding.Status)
                                        </MudChip>
                                    </td>
                                    <td>@finding.Reference</td>
                                    <td>@finding.Counterparty</td>
                                    <td class="tabular-nums">@QualityCheckTextFormatter.FormatDate(finding.Date)</td>
                                    <td class="tabular-nums">@QualityCheckTextFormatter.FormatDate(finding.DueDate)</td>
                                    <td class="fh-num-col tabular-nums">@(finding.DaysOverdue is > 0 ? finding.DaysOverdue.ToString() : "–")</td>
                                    <td class="fh-num-col tabular-nums">@(finding.OutstandingOre is { } ore ? Kr(ore) : "ukjent")</td>
                                    <td>@finding.Project</td>
                                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">@finding.Note</MudText></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="6">Sum</th>
                                <th class="fh-num-col tabular-nums">@Kr(section.TotalOre)</th>
                                <th colspan="2"></th>
                            </tr>
                        </tfoot>
                    </MudSimpleTable>
                }
            </MudPaper>
        }

        @if (report.Grants is { } grantSection)
        {
            <MudPaper Class="pa-4" Outlined @key="GrantCheckSection.Key">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@GrantCheckSection.Title</MudText>
                @if (grantSection.MissingDataNote is not null)
                {
                    <MudAlert Severity="Severity.Warning" Dense Class="mb-2">@grantSection.MissingDataNote</MudAlert>
                }
                @if (grantSection.Findings.Count == 0)
                {
                    <MudText Color="@(grantSection.MissingDataNote is null ? Color.Success : Color.Default)">
                        @(grantSection.MissingDataNote is null ? "Ingen funn." : "Ingen funn i kontrollene som ble kjørt.")
                    </MudText>
                }
                else
                {
                    <MudSimpleTable Dense Hover Bordered Style="overflow-x: auto">
                        <thead>
                            <tr>
                                <th>Status</th>
                                <th>Tilskudd</th>
                                <th>Kontroll</th>
                                <th>Detalj</th>
                                <th class="fh-num-col">Beløp (kr)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var finding in grantSection.Findings)
                            {
                                <tr>
                                    <td>
                                        <MudChip T="string" Size="Size.Small" Color="StatusColor(finding.Status)">
                                            @QualityCheckTextFormatter.StatusText(finding.Status)
                                        </MudChip>
                                    </td>
                                    <td><MudLink Href="@finding.Href">@finding.GrantName</MudLink></td>
                                    <td>@finding.Check</td>
                                    <td><MudText Typo="Typo.body2" Color="Color.Secondary">@finding.Detail</MudText></td>
                                    <td class="fh-num-col tabular-nums">@(finding.Amount is { } amount ? Kr((long)Math.Round(amount * 100m, MidpointRounding.AwayFromZero)) : "–")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        }
    }
</MudStack>
</PageErrorBoundary>

@code {
    private static readonly CultureInfo Nb = CultureInfo.GetCultureInfo("nb-NO");

    private QualityCheckData? data;
    private QualityCheckReport? report;
    private IReadOnlyList<Grant>? grantList;
    private GrantFikenData? grantFiken;
    private string? grantError;
    private DateOnly today;
    private DateOnly referenceDate;
    private bool hasCompany = true;
    private bool isLoading;
    private bool isCopying;
    private string? errorMessage;
    private IJSObjectReference? clipboardModule;
    private int datePickerKey;
    private readonly CancellationTokenSource disposeCts = new();

    private DateTime? ReferenceDateTime => referenceDate.ToDateTime(TimeOnly.MinValue);

    private bool IsToday => referenceDate == today;

    private bool IsLastYearEnd => referenceDate == new DateOnly(today.Year - 1, 12, 31);

    private static Dictionary<string, object> PressedAttributes(bool pressed) =>
        new() { ["aria-pressed"] = pressed ? "true" : "false" };

    protected override async Task OnInitializedAsync()
    {
        today = QualityChecks.Today;
        referenceDate = today;

        if (RendererInfo.IsInteractive)
        {
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Last modulen på forhånd, så kopieringen skjer raskt nok etter klikket (Safari og Firefox krever det).
        if (firstRender)
        {
            try
            {
                clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
            {
                Logger.LogDebug(ex, "Klarte ikke å laste clipboard.js på forhånd");
            }
        }
    }

    private async Task LoadAsync(bool refresh = false)
    {
        if (isLoading)
        {
            return;
        }

        CancellationToken ct;
        try
        {
            ct = disposeCts.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;
        try
        {
            var settings = await ConfigStore.LoadSettingsAsync(ct);
            hasCompany = !string.IsNullOrWhiteSpace(settings.FikenCompanySlug);
            await LoadGrantsAsync(refresh, ct);
            if (!hasCompany)
            {
                data = null;
                return;
            }

            data = await QualityChecks.FetchAsync(settings.FikenCompanySlug!, ct);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (FikenApiException ex)
        {
            Logger.LogWarning(ex, "Fiken-feil ved kvalitetssjekk");
            errorMessage = UserErrors.Describe(ex, "Klarte ikke å hente åpne poster fra Fiken");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Klarte ikke å kjøre kvalitetssjekk");
            errorMessage = UserErrors.Describe(ex, "Klarte ikke å hente åpne poster fra Fiken");
        }
        finally
        {
            Rebuild();
            isLoading = false;
        }
    }

    // Tilskudd leses lokalt, og Fiken-delen kan mangle uten at resten av sjekken stopper.
    private async Task LoadGrantsAsync(bool refresh, CancellationToken ct)
    {
        grantError = null;
        grantFiken = null;
        try
        {
            grantList = (await Grants.LoadAsync(ct)).Grants;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Klarte ikke å lese tilskudd");
            grantList = null;
            return;
        }

        try
        {
            grantFiken = await Grants.LoadFikenAsync(Grants.YearsFor(grantList), refresh, ct);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Klarte ikke å hente posteringer for tilskudd");
            grantError = UserErrors.Describe(ex, "Klarte ikke å hente posteringer fra Fiken");
        }
    }

    // Dato endres uten nye kall til Fiken: reglene kjøres på nytt på data som allerede er hentet.
    private void Rebuild()
    {
        var grants = grantList is null
            ? null
            : GrantCheckRules.Build(grantList, grantFiken ?? GrantFikenData.None, referenceDate, grantError);
        var baseReport = data?.BuildReport(referenceDate)
            ?? (grants is null ? null : new QualityCheckReport(referenceDate, DateTimeOffset.Now, []));
        report = baseReport is null ? null : baseReport with { Grants = grants };
    }

    private void HandleDateChanged(DateTime? value)
    {
        if (value is { } date)
        {
            referenceDate = DateOnly.FromDateTime(date);
        }
        else
        {
            // Tømt felt: gå tilbake til i dag, og tegn datovelgeren på nytt så feltet ikke står tomt.
            today = QualityChecks.Today;
            referenceDate = today;
            datePickerKey++;
        }

        Rebuild();
    }

    private void SetToday()
    {
        today = QualityChecks.Today;
        referenceDate = today;
        Rebuild();
    }

    private void SetLastYearEnd()
    {
        today = QualityChecks.Today;
        referenceDate = new DateOnly(today.Year - 1, 12, 31);
        Rebuild();
    }

    private async Task CopyTableAsync()
    {
        if (report is null)
        {
            return;
        }

        await CopyAsync("copyRichText", "Tabellen er kopiert.",
            QualityCheckTextFormatter.ToHtml(report), QualityCheckTextFormatter.ToTabSeparated(report));
    }

    private async Task CopyMarkdownAsync()
    {
        if (report is null)
        {
            return;
        }

        await CopyAsync("copyText", "Markdown er kopiert.", QualityCheckTextFormatter.ToMarkdown(report));
    }

    private async Task CopyAsync(string function, string successMessage, params object[] args)
    {
        if (isCopying)
        {
            return;
        }

        isCopying = true;
        try
        {
            clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
            var result = await clipboardModule.InvokeAsync<string>(function, args);
            switch (result)
            {
                case "insecure":
                    Snackbar.Add(
                        "Nettleseren gir ikke tilgang til utklippstavlen. Kopiering krever at siden er åpnet via https eller localhost.",
                        Severity.Warning);
                    break;
                case "text" when function == "copyRichText":
                    Snackbar.Add("Kopiert som ren tekst. Nettleseren tillot ikke tabellformat.", Severity.Info);
                    break;
                default:
                    Snackbar.Add(successMessage, Severity.Success);
                    break;
            }
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Kopiering til utklippstavlen feilet");
            Snackbar.Add(
                "Nettleseren tillot ikke kopiering. Prøv igjen, eller bruk en annen nettleser (Safari kan avvise kopiering fra denne siden).",
                Severity.Warning);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            Logger.LogDebug(ex, "Kopiering avbrutt fordi forbindelsen til nettleseren ble brutt");
        }
        finally
        {
            isCopying = false;
        }
    }

    private static string Kr(long ore) => QualityCheckTextFormatter.FormatKroner(ore);

    private static Color StatusColor(QualityStatus status) => status switch
    {
        QualityStatus.Overdue => Color.Error,
        QualityStatus.CheckManually => Color.Warning,
        QualityStatus.Credit => Color.Info,
        QualityStatus.Open => Color.Default,
        _ => Color.Success
    };

    private static string SectionStatusText(QualityCheckSection section) => section.Status switch
    {
        QualityStatus.Ok => "OK",
        QualityStatus.Overdue => "Forfalt",
        QualityStatus.CheckManually => "Sjekk",
        _ => "Åpne poster"
    };

    private static string GrantSummaryStatusText(GrantCheckSection section) => section.Status switch
    {
        QualityStatus.Ok => "OK",
        QualityStatus.Overdue => "Frist/forfalt",
        QualityStatus.CheckManually => "Sjekk",
        _ => "Frister nærmer seg"
    };

    public async ValueTask DisposeAsync()
    {
        disposeCts.Cancel();
        disposeCts.Dispose();
        if (clipboardModule is not null)
        {
            try
            {
                await clipboardModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
