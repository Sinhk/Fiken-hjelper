@page "/budsjett/oppsett"
@using System.Globalization
@rendermode InteractiveServer

<PageTitle>Rediger budsjett – Fiken-hjelper</PageTitle>
<MudProviders />
<NavigationLock ConfirmExternalNavigation="isDirty" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<MudStack Spacing="4">
    <MudPaper Class="pa-4" Outlined>
        <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h5" HtmlTag="h1">Rediger budsjett</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="budsjett">
                Til rapporten
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
        }

        @if (!hasCompany)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                Ingen Fiken-foretak er valgt, så prosjekter kan ikke kobles ennå. Koble til Fiken under
                <MudLink Href="innstillinger">Innstillinger</MudLink>.
            </MudAlert>
        }

        <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
            <MudSelect T="int" Label="År" Value="selectedYear" ValueChanged="SelectYearAsync"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense Style="min-width: 7rem"
                       Disabled="@(data.Years.Count == 0)">
                @foreach (var y in data.Years.Select(y => y.Year))
                {
                    <MudSelectItem Value="y">@y</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="int" Label="Nytt år" @bind-Value="newYear" Variant="Variant.Outlined" Margin="Margin.Dense"
                             HideSpinButtons Style="max-width: 7rem" Min="2000" Max="2100" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddYearAsync">Opprett år</MudButton>
            <MudSpacer />
            @if (isDirty)
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">Ulagrede endringer</MudChip>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync" Disabled="@(!isDirty || isSaving)">
                Lagre
            </MudButton>
        </MudStack>

        @if (current is null)
        {
            <MudAlert Severity="Severity.Info">
                Ingen budsjett er lagt inn ennå. Importer fra regnearket nedenfor, eller opprett et år og legg inn poster.
            </MudAlert>
        }
        else
        {
            <MudTabs Elevation="0" TabPanelsClass="pt-3" @bind-ActivePanelIndex="activeTab">
            <MudTabPanel Text="Budsjettposter">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                Inntekter skrives som positive beløp og kostnader som negative. Regnskapet hentes fra de koblede Fiken-prosjektene.
                Fyll bare ut «Manuelt regnskap» for år uten prosjekter i Fiken.
            </MudText>

            <MudSimpleTable Dense Bordered Style="overflow-x: auto">
                <thead>
                    <tr>
                        <th style="min-width: 14rem">Budsjettpost</th>
                        <th style="min-width: 9rem" class="fh-num-col">Budsjett</th>
                        <th style="min-width: 9rem" class="fh-num-col">Manuelt regnskap</th>
                        <th style="min-width: 20rem">Fiken-prosjekter</th>
                        <th style="width: 7.5rem"><span class="visually-hidden">Handlinger</span></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < current.Lines.Count; i++)
                    {
                        var index = i;
                        var line = current.Lines[index];
                        <tr @key="line">
                            <td>
                                <MudTextField T="string" Value="line.Name" ValueChanged="v => { line.Name = v; MarkDirty(); }"
                                              Variant="Variant.Text" Margin="Margin.Dense" aria-label="Navn på budsjettpost" />
                            </td>
                            <td>
                                <MudNumericField T="decimal" Value="line.Amount" ValueChanged="v => { line.Amount = v; MarkDirty(); }"
                                                 Culture="Nb" Format="#,##0.##" HideSpinButtons Margin="Margin.Dense"
                                                 Class="fh-num-input" aria-label="@($"Budsjett for {line.Name}")" />
                            </td>
                            <td>
                                <MudNumericField T="decimal?" Value="line.ManualActual" ValueChanged="v => { line.ManualActual = v; MarkDirty(); }"
                                                 Culture="Nb" Format="#,##0.##" HideSpinButtons Clearable Margin="Margin.Dense"
                                                 Placeholder="Fra Fiken" Class="fh-num-input" aria-label="@($"Manuelt regnskap for {line.Name}")" />
                            </td>
                            <td>
                                <div class="d-flex flex-wrap align-center gap-1">
                                    @foreach (var id in line.ProjectIds.Where(id => !projectsLoaded || projectsById.ContainsKey(id)))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                 OnClose="_ => RemoveProject(line, id)" title="@UsedByOtherTitle(id, line)"
                                                 Color="@(UsedByOther(id, line) is null ? Color.Default : Color.Warning)">
                                            @ProjectName(id)
                                            @if (SharedShare(line, id) is { } share)
                                            {
                                                <span class="tabular-nums"> · @share</span>
                                            }
                                        </MudChip>
                                    }
                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="() => OpenPickerAsync(line)" Disabled="@(projects.Count == 0)"
                                               aria-label="@($"Velg prosjekter for {line.Name}")">
                                        @(projects.Count == 0 ? "Ingen prosjekter lastet" : line.ProjectIds.Count == 0 ? "Velg prosjekter" : "Endre")
                                    </MudButton>
                                </div>
                                @foreach (var missing in projectsLoaded ? line.ProjectIds.Where(id => !projectsById.ContainsKey(id)) : [])
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" OnClose="_ => RemoveProject(line, missing)">
                                        Ukjent prosjekt @missing
                                    </MudChip>
                                }
                            </td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)"
                                               OnClick="() => Move(line, -1)" aria-label="Flytt opp" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(index == current.Lines.Count - 1)"
                                               OnClick="() => Move(line, 1)" aria-label="Flytt ned" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="() => RemoveLine(line)" aria-label="@($"Slett {line.Name}")" />
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Budsjettert resultat</th>
                        <td class="fh-num-col tabular-nums"><strong>@current.Lines.Sum(l => l.Amount).ToString("N0", Nb)</strong></td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </MudSimpleTable>

            <MudStack Row Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">Legg til post</MudButton>
                @if (data.FindYear(current.Year - 1) is { } previous)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy"
                               OnClick="() => CopyFrom(previous)" Disabled="@(current.Lines.Count > 0)"
                               title="@(current.Lines.Count > 0 ? "Bare tilgjengelig for tomme år" : null)">
                        Kopier poster fra @previous.Year
                    </MudButton>
                }
                <MudSpacer />
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="DeleteYearAsync">
                    Slett @current.Year
                </MudButton>
            </MudStack>
            </MudTabPanel>

            <MudTabPanel Text="Prosjekter → poster" BadgeData="@UnlinkedBadge" BadgeColor="Color.Warning">
                @if (!projectsLoaded)
                {
                    <MudAlert Severity="Severity.Info">Prosjektene er ikke hentet fra Fiken.</MudAlert>
                }
                else if (IsLoadingActivity)
                {
                    <MudProgressLinear Indeterminate Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Class="mt-2">Henter posteringer for @current.Year fra Fiken …</MudText>
                }
                else if (CurrentActivity is null && !ActivityFailed)
                {
                    <MudAlert Severity="Severity.Info">
                        Posteringer for @current.Year er ikke hentet ennå.
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => LoadActivityAsync(current.Year)">Hent nå</MudButton>
                    </MudAlert>
                }
                else if (CurrentActivity is null)
                {
                    <MudAlert Severity="Severity.Warning">
                        Klarte ikke å hente posteringer for @current.Year.
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => LoadActivityAsync(current.Year, refresh: true)">Prøv igjen</MudButton>
                    </MudAlert>
                }
                else
                {
                    var rows = ProjectRows;
                    var visible = rows
                        .Where(r => !onlyUnlinked || r.Lines.Count == 0)
                        .Where(r => string.IsNullOrWhiteSpace(projectSearch)
                                    || Nb.CompareInfo.IndexOf(r.Project.Name, projectSearch.Trim(), CompareOptions.IgnoreCase) >= 0
                                    || (r.Project.Number?.Contains(projectSearch.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
                        .ToList();
                    var strong = rows.Count(r => r.Lines.Count == 0 && r.SuggestionIsStrong);

                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                        Prosjekter med posteringer i @current.Year. Velg hvilken budsjettpost hvert prosjekt hører til.
                        Endringene lagres med «Lagre» øverst.
                    </MudText>
                    <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                        <MudTextField T="string" @bind-Value="projectSearch" Immediate DebounceInterval="150" Clearable
                                      Placeholder="Søk etter prosjekt" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 18rem" aria-label="Søk etter prosjekt" />
                        <MudSwitch T="bool" @bind-Value="onlyUnlinked" Color="Color.Primary">Bare ukoblede (@rows.Count(r => r.Lines.Count == 0))</MudSwitch>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DoneAll" Disabled="@(strong == 0)"
                                   OnClick="AcceptStrongSuggestions">
                            Godta sikre forslag (@strong)
                        </MudButton>
                    </MudStack>

                    @if (visible.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success">
                            @(rows.Count == 0 ? $"Ingen prosjekter har posteringer i {current.Year}." : "Alle prosjekter med posteringer er koblet til en budsjettpost.")
                        </MudAlert>
                    }
                    else
                    {
                        <MudSimpleTable Dense Bordered Style="overflow-x: auto">
                            <thead>
                                <tr>
                                    <th style="min-width: 14rem">Prosjekt</th>
                                    <th style="min-width: 8rem" class="fh-num-col">Regnskap @current.Year</th>
                                    <th style="min-width: 16rem">Budsjettpost</th>
                                    <th style="min-width: 14rem">Forslag</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in visible)
                                {
                                    var r = row;
                                    <tr @key="r.Project.ProjectId">
                                        <td>
                                            @r.Project.Name
                                            @if (!string.IsNullOrWhiteSpace(r.Project.Number))
                                            {
                                                <MudText Inline Typo="Typo.caption" Color="Color.Secondary"> (@r.Project.Number)</MudText>
                                            }
                                            @if (r.Project.Completed)
                                            {
                                                <MudText Inline Typo="Typo.caption" Color="Color.Secondary"> – avsluttet</MudText>
                                            }
                                        </td>
                                        <td class="fh-num-col tabular-nums">@r.Activity.Amount.ToString("N0", Nb)</td>
                                        <td>
                                            @if (r.Lines.Count > 1)
                                            {
                                                var problem = ProjectSplits.Check(r.Project.ProjectId, r.Lines.Where(l => !l.ManualActual.HasValue).ToList());
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.body2" Color="@(problem is null ? Color.Default : Color.Warning)">
                                                        @string.Join(", ", r.Lines.Select(l => l.ShareOf(r.Project.ProjectId) is { } s ? $"{l.Name} {s.ToString("0.##", Nb)} %" : l.Name))
                                                        @if (problem is not null)
                                                        {
                                                            <span> – @(problem == ProjectSplitProblem.MissingShares ? "mangler fordelingsnøkkel" : "summerer ikke til 100 %")</span>
                                                        }
                                                    </MudText>
                                                    <MudSpacer />
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.CallSplit"
                                                               OnClick="() => OpenSplitAsync(r)">Fordel …</MudButton>
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                                <MudSelect T="int" Value="@(r.Lines.Count == 1 ? current.Lines.IndexOf(r.Lines[0]) : -1)"
                                                           ValueChanged="i => SetProjectLine(r.Project.ProjectId, i)"
                                                           Dense Margin="Margin.Dense" Variant="Variant.Text"
                                                           aria-label="@($"Budsjettpost for {r.Project.Name}")">
                                                    <MudSelectItem T="int" Value="-1">— ikke koblet —</MudSelectItem>
                                                    @for (var i = 0; i < current.Lines.Count; i++)
                                                    {
                                                        var index = i;
                                                        <MudSelectItem T="int" Value="index">@current.Lines[index].Name</MudSelectItem>
                                                    }
                                                </MudSelect>
                                                <MudIconButton Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" OnClick="() => OpenSplitAsync(r)"
                                                               title="Fordel på flere poster" aria-label="@($"Fordel {r.Project.Name} på flere poster")" />
                                                </MudStack>
                                            }
                                        </td>
                                        <td>
                                            @if (r.Suggestion is { } suggestion)
                                            {
                                                <MudButton Variant="@(r.SuggestionIsStrong ? Variant.Filled : Variant.Outlined)" Size="Size.Small"
                                                           Color="Color.Primary" StartIcon="@Icons.Material.Filled.Lightbulb"
                                                           OnClick="() => SetProjectLine(r.Project.ProjectId, current.Lines.IndexOf(suggestion.Item))"
                                                           title="@LineMatchText(suggestion)">
                                                    @suggestion.Item.Name
                                                </MudButton>
                                                <MudText Inline Typo="Typo.caption" Color="Color.Secondary" Class="ml-1">@LineMatchText(suggestion)</MudText>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            </MudTabPanel>
            </MudTabs>
        }
    </MudPaper>

    <MudPaper Class="pa-4" Outlined>
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Importer fra regneark</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            Last ned «Sammenstilling av budsjett og regnskap» fra Google Sheets som .xlsx og velg filen her.
            Budsjettpostene leses fra oversiktsarket, og prosjektkoblingene fra arkene «Regnskap ÅÅÅÅ».
            År uten eget prosjektark får regnskapstallene som manuelle tall.
        </MudText>

        <MudFileUpload T="IBrowserFile" Accept=".xlsx" FilesChanged="ReadImportFileAsync" MaxFileSize="MaxImportBytes">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
                           OnClick="@context.OpenFilePickerAsync" Disabled="@(isImporting || isLoadingProjects)">
                    @(isLoadingProjects ? "Henter prosjekter fra Fiken …" : "Velg .xlsx-fil")
                </MudButton>
            </CustomContent>
        </MudFileUpload>

        @if (importPreview is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4">Fant @importPreview.Years.Count år i «@importFileName»</MudText>
            <MudList T="int" Dense>
                @foreach (var y in importPreview.Years)
                {
                    var year = y;
                    <MudListItem T="int">
                        <MudCheckBox T="bool" Value="importSelection.Contains(year.Year)" ValueChanged="v => ToggleImportYear(year.Year, v)">
                            @year.Year: @year.Lines.Count poster, budsjettert resultat @year.Lines.Sum(l => l.Amount).ToString("N0", Nb),
                            @(year.Lines.Any(l => l.ManualActual.HasValue) ? "manuelle regnskapstall" : $"{year.Lines.Sum(l => l.ProjectIds.Count)} prosjektkoblinger")
                            @if (data.FindYear(year.Year) is not null)
                            {
                                <MudText Inline Typo="Typo.caption" Color="Color.Warning"> (erstatter eksisterende)</MudText>
                            }
                        </MudCheckBox>
                    </MudListItem>
                }
            </MudList>

            @if (importPreview.Suggestions.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">Prosjektnavn uten eksakt treff i Fiken</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Huk av forslagene som stemmer. Sikre forslag er huket av på forhånd. Prosjekter uten hake kobles ikke.
                </MudText>
                <MudSimpleTable Dense Bordered Style="overflow-x: auto">
                    <thead>
                        <tr>
                            <th style="width: 4rem">Koble</th>
                            <th>Navn i arket</th>
                            <th>Budsjettpost</th>
                            <th style="min-width: 16rem">Fiken-prosjekt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var suggestion in importPreview.Suggestions)
                        {
                            var sug = suggestion;
                            <tr>
                                <td>
                                    <MudCheckBox T="bool" Value="acceptedSuggestions.Contains(sug)" Dense
                                                 ValueChanged="v => ToggleSuggestion(sug, v)" aria-label="@($"Koble {sug.SheetName}")" />
                                </td>
                                <td>@sug.SheetName</td>
                                <td>
                                    @string.Join("; ", sug.Targets.GroupBy(t => t.LineName, StringComparer.CurrentCultureIgnoreCase)
                                        .Select(g => $"{g.Key} ({string.Join(", ", g.Select(t => t.Year).Order())})"))
                                </td>
                                <td>
                                    <MudSelect T="long" Value="suggestionChoices[sug]" ValueChanged="id => ChooseSuggestion(sug, id)"
                                               Dense Margin="Margin.Dense" Variant="Variant.Text" aria-label="@($"Fiken-prosjekt for {sug.SheetName}")">
                                        @foreach (var candidate in sug.Candidates)
                                        {
                                            <MudSelectItem T="long" Value="candidate.Item.ProjectId">@candidate.Item.Name (likhet @candidate.Score %)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }

            @if (importPreview.Warnings.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="my-2">
                    <ul class="mb-0">
                        @foreach (var w in importPreview.Warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                </MudAlert>
            }

            <MudStack Row Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyImportAsync" Disabled="@(importSelection.Count == 0 || isSaving)">
                    Importer valgte år
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="() => importPreview = null">Avbryt</MudButton>
            </MudStack>
        }
    </MudPaper>
</MudStack>
